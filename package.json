{
  "name": "commerce-core-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 POS monorepo foundation for Commerce Core.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pos/web",
    "dev:web": "npm run dev --workspace @pos/web",
    "dev:api": "npm run start:dev --workspace @pos/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @pos/api"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
