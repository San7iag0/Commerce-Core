enum TaxType {
  PERCENTAGE
  FIXED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  LOSS
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  QR
  OTHER
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum InventoryReferenceType {

  SALE

  PURCHASE

  ADJUSTMENT

  RETURN

  TRANSFER

}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  isSystem    Boolean  @default(false)

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([name])
}

model User {
  id            String   @id @default(uuid())

  roleId        String
  role          Role @relation(fields: [roleId], references: [id])

  firstName     String
  lastName      String

  email         String   @unique
  passwordHash  String

  phone         String?

  isActive      Boolean @default(true)

  lastLoginAt   DateTime?

  sales         Sale[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([email])
}

model Category {

  id            String @id @default(uuid())

  name          String @unique

  description   String?

  displayOrder  Int @default(0)

  isActive      Boolean @default(true)

  products      Product[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model Tax {

  id                String @id @default(uuid())

  code              String @unique

  name              String

  rate              Decimal @db.Decimal(14,4)

  type              TaxType

  includedInPrice   Boolean @default(false)

  isActive          Boolean @default(true)

  productTaxes      ProductTax[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
model Product {

  id String @id @default(uuid())

  categoryId String
  category Category @relation(fields: [categoryId], references: [id])

  name String
  description String?

  trackInventory Boolean @default(true)
  allowNegativeStock Boolean @default(false)

  unitOfMeasureId String
  unitOfMeasure UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  variants ProductVariant[]

  taxes ProductTax[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model ProductVariant {

  id String @id @default(uuid())

  productId String
  product Product @relation(fields: [productId], references: [id])

  sku String @unique
  barcode String? @unique

  name String

  baseCost Decimal @db.Decimal(14,4)

  basePrice Decimal @db.Decimal(14,4)

  minimumStock Decimal @db.Decimal(14,4)

  currentStock Decimal @db.Decimal(14,4)

  inventoryMovements InventoryMovement[]

  saleItems SaleItem[]
}

model ProductTax {

  productId String

  taxId String

  priority Int @default(1)

  product Product @relation(fields:[productId], references:[id])

  tax Tax @relation(fields:[taxId], references:[id])

  @@id([productId,taxId])

}

model UnitOfMeasure {

  id          String @id @default(uuid())

  code        String @unique

  name        String

  symbol      String

  isActive    Boolean @default(true)

  products    Product[]

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt

}

model CashRegister {

  id          String   @id @default(uuid())

  code        String   @unique

  name        String

  status      CashRegisterStatus @default(CLOSED)

  isActive    Boolean @default(true)

  sales       Sale[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

}

// sale photo
model Sale {

  id              String @id @default(uuid())

  number          String @unique

  cashierId       String

  cashier         User @relation(fields:[cashierId], references:[id])

  cashRegisterId  String

  cashRegister    CashRegister @relation(fields:[cashRegisterId], references:[id])

  status          SaleStatus @default(DRAFT)

  subtotal        Decimal @db.Decimal(14,4)

  discountAmount  Decimal @default(0) @db.Decimal(14,4)

  taxAmount       Decimal @default(0) @db.Decimal(14,4)

  total           Decimal @db.Decimal(14,4)

  notes           String?

  items           SaleItem[]

  payments        Payment[]

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

  deletedAt       DateTime?

  completedAt DateTime?

  @@index([number])

  @@index([createdAt])

}
// product photo, check ProductVariant as change for product
model SaleItem {

  id String @id @default(uuid())

  saleId String

  sale Sale @relation(fields:[saleId], references:[id])

  productId String

  product ProductVariant @relation(fields:[productId], references:[id])

  sku String

  productName String

  quantity Decimal @db.Decimal(14,4)

  unitCost Decimal @db.Decimal(14,4)

  unitPrice Decimal @db.Decimal(14,4)

  discountAmount Decimal @default(0) @db.Decimal(14,4)

  taxAmount Decimal @default(0) @db.Decimal(14,4)

  subtotal Decimal @db.Decimal(14,4)

  total Decimal @db.Decimal(14,4)

  createdAt DateTime @default(now())

  @@index([saleId])

  @@index([productId])

}

model Payment {

  id String @id @default(uuid())

  saleId String

  sale Sale @relation(fields:[saleId], references:[id])

  method PaymentMethod

  amount Decimal @db.Decimal(14,4)

  currency String @default("USD")

  exchangeRate Decimal? @db.Decimal(14,6)

  reference String?

  notes String?

  createdAt DateTime @default(now())

}

// keep record for whom, date, stock
model InventoryMovement {

  id String @id @default(uuid())

  productId String

  product Product @relation(fields:[productId], references:[id])

  type InventoryMovementType

  quantity Decimal @db.Decimal(14,4)

  previousStock Decimal @db.Decimal(14,4)

  newStock Decimal @db.Decimal(14,4)

  referenceId String

  notes String?

  createdById String

  createdBy User @relation(fields:[createdById], references:[id])

  createdAt DateTime @default(now())

  @@index([productId])

  @@index([referenceId])

}

// handle different business
model Business {

  id          String @id @default(uuid())

  name        String

  legalName   String?

  taxId       String @unique

  email       String?

  phone       String?

  address     String?

  currency    String @default("USD")

  timezone    String @default("UTC")

  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt
}

model Branch {

  id String @id @default(uuid())

  businessId String

  business Business
      @relation(fields:[businessId], references:[id])

  code String

  name String

  address String?

  phone String?

  isActive Boolean @default(true)

  cashRegisters CashRegister[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}
